<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MarketPulse.Demo.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/app.ico" ToolTipText="MarketPulse — fictional portfolio" Clicked="OpenWindow">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open MarketPulse demo" Click="OpenWindow" />
            <NativeMenuItem Header="Refresh demo" Click="RefreshDemo" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="ExitDemo" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
